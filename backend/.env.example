# Copy to backend/.env (git-ignored). Used by docker compose (postgres and app) and by the backend run outside Docker.

# PostgreSQL container. Compose creates the database and user from these.
POSTGRES_DB=connecta
POSTGRES_USER=connecta
# Required. Keep DB_PASSWORD equal to this value.
POSTGRES_PASSWORD=change-me

# Spring profile and HTTP server (compose forces the prod profile)
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# PostgreSQL for the backend. Compose overrides DB_URL to reach the postgres service.
DB_URL=jdbc:postgresql://localhost:5432/connecta
DB_USER=connecta
DB_PASSWORD=change-me

# Browser origins allowed to call the API (comma separated). Required in prod.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Access token signing secret: 32+ random bytes. Generate one with: openssl rand -base64 48
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes

# Invitation email (leave SMTP_HOST empty to disable delivery). With the mailpit profile: SMTP_HOST=mailpit, SMTP_PORT=1025.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
MAIL_FROM=connecta@localhost
FRONTEND_URL=http://localhost:3000

# Meta connection (Facebook Login for Business). Optional: blank app values make the Meta features answer 503.
# META_MESSENGER_CONFIG_ID is the Facebook Login for Business configuration with pages_show_list, pages_messaging,
# pages_manage_metadata and business_management. APP_BASE_URL is the public backend address (for example a tunnel);
# Meta redirects to APP_BASE_URL/api/meta/oauth/callback, so register that URI in the app.
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v27.0
META_MESSENGER_CONFIG_ID=
APP_BASE_URL=http://localhost:8080
# Instagram Business Login app (Use cases > Instagram > API setup with Instagram login). Blank = Instagram answers 503.
META_INSTAGRAM_APP_ID=
META_INSTAGRAM_APP_SECRET=
# Webhook verify token: any string you choose; enter the same value in the Meta app's webhook settings.
META_WEBHOOK_VERIFY_TOKEN=
# Encrypts stored Meta tokens. Required in prod: 32 random bytes, base64 encoded. Generate with: openssl rand -base64 32
# Leave it unset (commented) in dev so the dev default applies; an empty value would not fall back to it.
# META_TOKEN_KEY=

# S3-compatible product image storage (optional in dev; blank keeps images in memory).
# MinIO on the host: S3_ENDPOINT=http://localhost:9000, S3_PATH_STYLE_ACCESS=true, S3_PUBLIC_BASE_URL=http://localhost:9000/<bucket>
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PATH_STYLE_ACCESS=false
S3_PUBLIC_BASE_URL=

# Local runs: false so restarts never apply migrations. Compose forces true.
SPRING_FLYWAY_ENABLED=false

# MinIO (docker compose --profile dev). Root login of the local S3; reuse as S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
