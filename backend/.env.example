# Spring profile and HTTP server
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/connecta
DB_USER=connecta
DB_PASSWORD=change-me

# Frontend origin and JWT signing secret
CORS_ALLOWED_ORIGINS=http://localhost:3000
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes

# Invitation email (leave SMTP_HOST empty to disable delivery)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
MAIL_FROM=connecta@localhost
FRONTEND_URL=http://localhost:3000

# S3-compatible product image storage (optional in dev)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PATH_STYLE_ACCESS=false
S3_PUBLIC_BASE_URL=
