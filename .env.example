# Copy to .env (git-ignored). docker compose reads it automatically.
# The backend reads real environment variables, not this file: export them, or rely on the dev profile defaults.

# --- docker-compose: PostgreSQL container ---
POSTGRES_DB=connecta
POSTGRES_USER=connecta
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# --- backend ---
# Profile: dev (default, local defaults) or prod (no defaults, all values below are required)
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
DB_URL=jdbc:postgresql://localhost:5432/connecta
DB_USER=connecta
DB_PASSWORD=change-me
# Browser origins allowed to call the API (comma separated). Required in prod.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Secret used to sign access tokens: 32+ random bytes, required in prod (dev has a built-in default).
# Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-bytes

# --- frontend (put in frontend/.env.local; Next.js does not read the root .env) ---
# Backend base URL used by the browser
NEXT_PUBLIC_API_URL=http://localhost:8080
