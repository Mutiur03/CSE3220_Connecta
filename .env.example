# Copy to .env (git-ignored). docker compose reads it automatically and requires the values marked required.
# Outside Docker the backend reads real environment variables, not this file: export them, or rely on the dev profile defaults.

# --- docker-compose: PostgreSQL container (also the app's DB credentials in compose) ---
POSTGRES_DB=connecta
POSTGRES_USER=connecta
# Required
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Host ports published by compose
FRONTEND_PORT=3000

# --- backend ---
# Compose runs the prod profile (no secret defaults). Use dev only when running the backend outside Docker.
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
# Compose derives DB_URL (host "postgres"), DB_USER and DB_PASSWORD from POSTGRES_*.
# The three lines below are only for running the backend outside Docker.
DB_URL=jdbc:postgresql://localhost:5432/connecta
DB_USER=connecta
DB_PASSWORD=change-me
# Browser origins allowed to call the API (comma separated). Required.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Secret used to sign access tokens: 32+ random bytes. Required in prod.
# Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-bytes

# --- invitation email (SMTP) ---
# Invitations are emailed as a link to the accept page. A blank SMTP_HOST sends nothing (the invitation
# is still created). The dev profile defaults to Mailpit on localhost:1025.
# With "docker compose --profile dev up": SMTP_HOST=mailpit, SMTP_PORT=1025, SMTP_STARTTLS=false.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
# Sender address shown on invitation emails. Required in prod (compose defaults it).
MAIL_FROM=connecta@example.com
# Public address of the web app: the invitation link points here. Required in prod (compose defaults it).
FRONTEND_URL=http://localhost:3000

# --- product images (Cloudflare R2, S3 API) ---
# All five are needed to use R2. Blank means not configured: dev then keeps images in memory, and prod
# refuses to start. Create an R2 API token with object read and write on this one bucket.
R2_ACCOUNT_ID=change-me
R2_BUCKET=change-me
R2_ACCESS_KEY_ID=change-me
R2_SECRET_ACCESS_KEY=change-me
# Public URL the bucket is served from, without a trailing slash.
R2_PUBLIC_BASE_URL=https://images.example.com

# --- frontend ---
# Backend base URL used by the browser. Required by compose (baked into the image at build time).
# For pnpm dev, put it in frontend/.env.local instead.
# Server-side backend URL (server actions, /session/refresh). Set in docker-compose.yml to http://app:8080.
# Outside Docker it defaults to NEXT_PUBLIC_API_URL.
NEXT_PUBLIC_API_URL=http://localhost:8080
