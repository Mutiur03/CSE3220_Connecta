# Copy to .env (git-ignored). docker compose reads it automatically and requires the values marked required.
# Outside Docker the backend reads real environment variables, not this file: export them, or rely on the dev profile defaults.

# --- docker-compose: PostgreSQL container (also the app's DB credentials in compose) ---
POSTGRES_DB=connecta
POSTGRES_USER=connecta
# Required
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Host ports published by compose
FRONTEND_PORT=3000

# --- backend ---
# Compose runs the prod profile (no secret defaults). Use dev only when running the backend outside Docker.
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
# Compose derives DB_URL (host "postgres"), DB_USER and DB_PASSWORD from POSTGRES_*.
# The three lines below are only for running the backend outside Docker.
DB_URL=jdbc:postgresql://localhost:5432/connecta
DB_USER=connecta
DB_PASSWORD=change-me
# Browser origins allowed to call the API (comma separated). Required.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Secret used to sign access tokens: 32+ random bytes. Required in prod.
# Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-bytes

# --- frontend ---
# Backend base URL used by the browser. Required by compose (baked into the image at build time).
# For pnpm dev, put it in frontend/.env.local instead.
NEXT_PUBLIC_API_URL=http://localhost:8080
