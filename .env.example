# Copy to .env (git-ignored). docker compose reads it automatically.
# The backend reads real environment variables, not this file: export them, or rely on the dev profile defaults.

# --- docker-compose: PostgreSQL container ---
POSTGRES_DB=connecta
POSTGRES_USER=connecta
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# --- backend ---
# Profile: dev (default, local defaults) or prod (no defaults, all values below are required)
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
DB_URL=jdbc:postgresql://localhost:5432/connecta
DB_USER=connecta
DB_PASSWORD=change-me
