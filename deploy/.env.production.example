# Production settings for the VPS. On the server this lives at /opt/connecta/.env (chmod 600), never in git.
# Copy this file and replace every value marked CHANGE. Secrets have no defaults: the stack refuses to start without them.

# ---- Public hostnames (DNS A/AAAA records must point at the VPS) ----------------------------------------------
APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com
# Public hostname for product images (a CDN-style name; Cloudflare proxying can be added later).
FILES_DOMAIN=cdn.example.com
# Certificate registration and expiry notices.
ACME_EMAIL=ops@example.com

# ---- Images (GHCR) ---------------------------------------------------------------------------------------------
# GitHub owner of the repository, lower case. Images: ghcr.io/<owner>/connecta-backend and connecta-frontend.
GHCR_OWNER=CHANGE-github-owner
# Tag to run. The deploy workflow overrides this with the commit SHA on every deploy; "latest" is for a manual start.
IMAGE_TAG=latest

# ---- PostgreSQL (the backend's DB_USER and DB_PASSWORD are taken from these) ---------------------------------
POSTGRES_DB=connecta
POSTGRES_USER=connecta
# CHANGE. Generate: openssl rand -base64 24
POSTGRES_PASSWORD=CHANGE-me

# ---- Auth and encryption (required, no defaults) -----------------------------------------------------------------
# CHANGE. Access token signing secret, 32+ random bytes. Generate: openssl rand -base64 48
JWT_SECRET=CHANGE-me-with-at-least-32-random-bytes-xxxxxxxx
# CHANGE. Encrypts stored Meta tokens: 32 random bytes, base64. Generate: openssl rand -base64 32
# Losing or changing it makes the stored Meta connections unreadable.
META_TOKEN_KEY=CHANGE-me-openssl-rand-base64-32

# ---- Product image storage: MinIO on this server (the backend gets these as S3_*) -------------------------------
S3_BUCKET=connecta
S3_REGION=us-east-1
# CHANGE both. MinIO root login, reused by the backend as the S3 access key and secret.
MINIO_ROOT_USER=CHANGE-minio-user
MINIO_ROOT_PASSWORD=CHANGE-minio-password-at-least-8-chars

# ---- Invitation e-mail (SMTP_HOST empty = nothing is sent; the admin can still copy the link) ------------------
MAIL_FROM=connecta@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true

# ---- Meta (Messenger and Instagram). Blank app values make the Meta features answer 503 ----------------------
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v27.0
META_MESSENGER_CONFIG_ID=
META_INSTAGRAM_APP_ID=
META_INSTAGRAM_APP_SECRET=
# Any string you choose; enter the same value in the Meta app's webhook settings. Callback URL:
# https://<API_DOMAIN>/api/meta/webhooks . OAuth redirect URI to register: https://<API_DOMAIN>/api/meta/oauth/callback
META_WEBHOOK_VERIFY_TOKEN=
META_HIDE_VIEW_ONCE=false

# ---- Optional tuning ------------------------------------------------------------------------------------------
PRESENCE_GRACE_PERIOD=60s
PRESENCE_HEARTBEAT_INTERVAL=30s

# ---- Derived by docker-compose.prod.yml, do not set ------------------------------------------------------------
# CORS_ALLOWED_ORIGINS, FRONTEND_URL = https://APP_DOMAIN     APP_BASE_URL, PUBLIC_BASE_URL = https://API_DOMAIN
# S3_ENDPOINT = http://minio:9000, S3_PUBLIC_BASE_URL = https://FILES_DOMAIN, DB_URL, S3_REQUIRED, SPRING_FLYWAY_ENABLED
# GEOIP_DB_PATH (database is baked into the backend image), API_URL (frontend -> backend over the compose network)
#
# ---- Build time, not on the server -----------------------------------------------------------------------------
# NEXT_PUBLIC_API_URL (https://<API_DOMAIN>) is baked into the frontend image by CI from the GitHub repository
# variable NEXT_PUBLIC_API_URL. Changing the API domain means a new image build, not an edit here.

# ---- Monitoring (optional, deploy/docker-compose.monitoring.yml) -----------------------------------------------
# Only needed when you start the monitoring overlay by hand (see docs/operations.md).
# CHANGE. Shared secret Prometheus sends to the backend (header X-Scrape-Token). Generate: openssl rand -base64 32
METRICS_SCRAPE_TOKEN=
# CHANGE. Grafana login, served on 127.0.0.1:3001 of the server (SSH tunnel). No default password.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# Backend log format: logstash (one JSON object per line, the default) or ecs.
LOG_FORMAT=logstash
